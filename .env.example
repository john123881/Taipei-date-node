# Taipei Date - Environment Variables Template
# 複製此檔案並重新命名為 .env，然後填入您的真實金鑰。

# 資料庫設定 (Aiven MySQL / Local)
DB_HOST=your-database-host
DB_PORT=15895
DB_NAME=defaultdb
DB_USER=your-username
DB_PASS=your-password
DATABASE_URL=mysql://user:pass@host:port/db?ssl-mode=REQUIRED

# 信件服務 (Nodemailer / GMail)
SMTP_TO_EMAIL=your-email@gmail.com
SMTP_TO_PASSWORD=your-app-password

# 加密金鑰
JWT_SECRET=your-32-character-secret
SESSION_SECRET=your-session-long-secret
OTP_SECRET=your-otp-secret

# AWS S3 設定
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=your-bucket-name

# 備援資料庫 (Optional)
JAWSDB_URL=mysql://user:pass@host:port/dbname
